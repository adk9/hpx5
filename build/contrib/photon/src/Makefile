	libphoton/$(am__dirstamp) libphoton/$(DEPDIR)/$(am__dirstamp)
libphoton/libphoton_la-photon_rdma_ledger.lo:  \
	libphoton/$(am__dirstamp) libphoton/$(DEPDIR)/$(am__dirstamp)
