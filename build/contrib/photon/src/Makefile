	$(AM_V_CCLD)$(libphoton_la_LINK) -rpath $(libdir) $(libphoton_la_OBJECTS) $(libphoton_la_LIBADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)
	-rm -f libphoton/*.$(OBJEXT)
	-rm -f libphoton/*.lo

distclean-compile:
	-rm -f *.tab.c

