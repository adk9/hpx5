#!/bin/sh

usage() {
        cat <<EOF
Usage:
  hpx-config <option>
Options:
  --help | -h  : Print usage.
  --version    : Print hpx version.
  --config     : Print configure options used to build hpx.
  --prefix     : Print installation directory prefix.
  --bindir     : Print binary installation directory.
  --includedir : Print include installation directory.
  --libdir     : Print library installation directory.
  --src-root   : Print the source root HPX was built from.
  --obj-root   : Print the object root used to build HPX.
  --host-cpu   : Print the host cpu used to configure HPX.
  --host-os    : Print the host os used to configure HPX. 
  --cc         : Print compiler used to build hpx.
  --cflags     : Print compiler flags used to build hpx.
  --cxx        : Print c++ compiler used to build hpx.
  --cxxflags   : Print cxx flags used to build HPX.
  --cppflags   : Print preprocessor flags used to build hpx.
  --ldflags    : Print the ld flags used to build HPX.
  --ccasflags  : Print the ccas flags used to build HPX.
  --libs       : Print libraries hpx was linked against.
EOF
}

prefix="/u/jsfiroz/hpx_2_pre/hpx_simple_coalescing/hpx/install"
exec_prefix="/u/jsfiroz/hpx_2_pre/hpx_simple_coalescing/hpx/install"
pkg_prefix="/u/jsfiroz/hpx_2_pre/hpx_simple_coalescing/hpx/install/lib/pkgconfig"

LIBS=$(PKG_CONFIG_PATH="$pkg_prefix" pkg-config --libs --static hpx)

case "$1" in
--help | -h)
        usage
        exit 0
        ;;
--version)
        echo "2.0.0"
        echo "Copyright (c) 2013-2015, Trustees of Indiana University."
        ;;
--config)
        echo "--prefix=/u/jsfiroz/hpx_2_pre/hpx_simple_coalescing/hpx/install --enable-parallel-config --enable-mpi --enable-photon 'CFLAGS=-O0 -g' --enable-debug PKG_CONFIG_PATH=/opt/openmpi/1.10.0_thread/lib/pkgconfig"
        ;;
--prefix)
        echo "/u/jsfiroz/hpx_2_pre/hpx_simple_coalescing/hpx/install"
        ;;
--bindir)
        echo "/u/jsfiroz/hpx_2_pre/hpx_simple_coalescing/hpx/install/bin"
        ;;
--includedir)
        echo "/u/jsfiroz/hpx_2_pre/hpx_simple_coalescing/hpx/install/include"
        ;;
--libdir)
        echo "/u/jsfiroz/hpx_2_pre/hpx_simple_coalescing/hpx/install/lib"
        ;;
--src-root)
        echo "/u/jsfiroz/hpx_2_pre/hpx_simple_coalescing/hpx/build/.."
        ;;
--obj-root)
        echo "/u/jsfiroz/hpx_2_pre/hpx_simple_coalescing/hpx/build"
        ;;
--host-cpu)
        echo "x86_64"
        ;;
--host-os)
        echo "linux-gnu"
        ;;
--cc)
        echo "gcc"
        ;;
--cflags)
        echo "-O0 -g"
        ;;
--cxx)
        echo "g++"
        ;;
--cxxflags)
        echo "-g -O2"
        ;;
--cppflags)
        echo ""
        ;;
--ldflags)
        echo ""
        ;;
--ccasflags)
        echo "-O0 -g"
        ;;
--libs)
        echo "$LIBS"
        ;;
*)
        usage
        exit 1
esac
